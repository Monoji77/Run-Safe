        <mxCell id="laptop-detail" value="Single machine, no high availability. Reported 16 GB + 16 GB RAM: verify. Redpanda data sits on an ext4 named volume inside WSL2, not a Windows or OneDrive path." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#475569;fontStyle=0;" vertex="1" parent="laptop">
