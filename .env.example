# Copy to .env (git-ignored) and change for anything beyond local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-only
POSTGRES_DB=runsafe
API_RO_PASSWORD=api-ro-dev-only
CONNECT_RW_PASSWORD=connect-rw-dev-only

# Optional: a data.gov.sg API key raises rate limits (sent as x-api-key).
DATA_GOV_SG_API_KEY=
