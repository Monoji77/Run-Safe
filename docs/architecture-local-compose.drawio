        </mxCell>
        <mxCell id="source" value="&lt;div style=&quot;font-family:Arial;text-align:left;line-height:1.3&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:bold;color:#475569&quot;&gt;EXTERNAL / INTERNET&lt;/div&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;color:#0F172A;margin-top:10px;margin-bottom:12px&quot;&gt;data.gov.sg&lt;/div&gt;&lt;div style=&quot;font-size:19px;color:#475569&quot;&gt;NEA: PSI, PM2.5, UVI&lt;br&gt;Hourly records, revised&lt;br&gt;~15 min cadence: verify&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;align=left;verticalAlign=top;spacing=18;spacingTop=54;shadow=0;" vertex="1" parent="1">
